<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/aq_active" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- The design's blue marker on the current item. -->
    <item android:bottom="12dp" android:gravity="start|fill_vertical" android:top="12dp" android:width="3dp">
        <shape>
            <solid android:color="@color/aq_primary" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
