<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/aqua_background" android:fitsSystemWindows="true">
    <TextView android:id="@+id/brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="Aqua Quenchers" android:textStyle="bold" android:textSize="22sp" android:textColor="@color/aqua_dark" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true"><LinearLayout android:id="@+id/navigation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" /></HorizontalScrollView>
    <ProgressBar android:id="@+id/loading" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true" android:visibility="gone" />
    <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:accessibilityLiveRegion="polite" android:textColor="@color/aqua_error" android:visibility="gone" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/page_padding" android:orientation="vertical" android:saveEnabled="true" /></ScrollView>
</LinearLayout>
